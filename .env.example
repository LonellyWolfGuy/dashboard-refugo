# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Nunca commite .env.local ou credenciais reais no Git.

# Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Supabase Dashboard > Project Settings > API > anon public
# Esta é a chave pública do frontend; a proteção dos dados depende das políticas RLS.
VITE_SUPABASE_KEY=sua-chave-anon-public

# Opcionais: remova ou deixe vazios se o monitoramento Umami não estiver configurado.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
