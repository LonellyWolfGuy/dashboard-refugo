# ==============================================================================
# CONFIGURAÇÃO DE CONEXÃO: PROTHEUS (SQL SERVER) -> SUPABASE
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente.
# ==============================================================================

# ─── 1. BANCO DE DADOS PROTHEUS (SQL SERVER) ──────────────────────────────────
DB_SERVER=192.168.1.100              # IP ou hostname do servidor SQL Server
DB_PORT=1433                         # Porta padrão (1433)
DB_DATABASE=protheus_producao        # Nome do banco de dados (ex: protheus, p12_prod)
DB_USER=sa                           # Usuário com permissão de leitura (SELECT)
DB_PASSWORD=sua_senha_aqui           # Senha do banco
DB_EMPRESA=01                        # Código da empresa Protheus (usado no sufixo 010)
DB_ENCRYPT=false                     # true para conexões com SSL/Azure, false para rede local
DB_TRUST_SERVER_CERT=true            # Manter true para evitar erro de certificado autoassinado

# ─── 2. SUPABASE (DASHBOARD DE REFUGO) ─────────────────────────────────────────
SUPABASE_URL=https://pjcyfwmhpahzxeuncrff.supabase.co
# Recomendado: use a SERVICE_ROLE_KEY do Supabase para o script rodar sem restrições de RLS
# Encontre em: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Alternativa caso não use service_role:
# SUPABASE_ANON_KEY=eyJhbGciOi...
